    "react-chartjs-2": "5.3.0",
    "react-dom": "^19.1.1",
    "react-redux": "9.2.0",
    "react-router-dom": "7.8.2",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "6.8.0",
